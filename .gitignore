# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

/.quarto/
**/*.quarto_ipynb

# _freeze/ é o cache de execução de código do Quarto (execute: freeze: auto
# em _quarto.yml) — precisa ir para o git de propósito, senão cada
# checkout novo (servidor, Codespace) perde o cache e recomputa tudo do
# zero no primeiro render. Uma regra global (fora deste projeto) ignora
# pastas "dist/", o que também escondia o _freeze do revealjs — as duas
# linhas abaixo forçam a inclusão apesar disso.
!_freeze/site_libs/revealjs/dist/
!_freeze/site_libs/revealjs/dist/**
